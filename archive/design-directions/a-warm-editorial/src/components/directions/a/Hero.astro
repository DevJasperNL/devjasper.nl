---
import { Picture } from 'astro:assets';
import photo from '../../../assets/jasper.png';
import { availability, hero, mailto } from '../../../data/site';
---

<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 md:px-10">
  <a href="#top" class="font-display a-display text-xl font-semibold">Jasper Lammers</a>
  <a
    href={mailto}
    class="rounded-full border border-ink/20 px-4 py-1.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    Email me
  </a>
</header>

<section id="top" class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-8 pb-20 md:grid-cols-[1.35fr_1fr] md:gap-16 md:px-10 md:pt-16 md:pb-28">
  <div>
    <p class="a-rise font-display a-display text-2xl italic text-accent md:text-3xl" style="--d: 0">
      {hero.greeting}
    </p>
    <h1 class="mt-4 font-display a-display text-[2.6rem] leading-[1.05] font-bold tracking-tight md:text-7xl">
      {hero.headline.map((line, i) => <span class="a-rise block" style={`--d: ${i + 1}`}>{line}</span>)}
    </h1>
    <p class="a-rise mt-8 max-w-[34rem] text-lg leading-relaxed text-muted md:text-xl" style="--d: 3">
      {hero.intro}
    </p>
    <div class="a-rise mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" style="--d: 4">
      <a
        href={mailto}
        class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-lg font-semibold text-white transition-colors hover:bg-accent-deep focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent"
      >
        Email me <span aria-hidden="true">&rarr;</span>
      </a>
      <p class="flex items-center gap-2.5 text-base">
        <span class="size-2.5 rounded-full bg-spark" aria-hidden="true"></span>
        Available from {availability}
      </p>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[22rem] md:max-w-none">
    <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-t-full border border-accent/40" aria-hidden="true"></div>
    <Picture
      src={photo}
      alt={hero.photoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      width={900}
      widths={[320, 480, 640, 900]}
      sizes="(min-width: 768px) 40vw, 22rem"
      loading="eager"
      fetchpriority="high"
      class="a-photo relative aspect-[4/5] w-full rounded-t-full object-cover object-[50%_30%]"
    />
  </div>
</section>
