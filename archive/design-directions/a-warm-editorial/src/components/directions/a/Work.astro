---
import { earlierWork, work } from '../../../data/site';
import WorkArt from '../WorkArt.astro';
---

<section aria-labelledby="a-work" class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
    <h2 id="a-work" class="font-display a-display text-4xl font-bold md:text-5xl">Selected work</h2>

    <div class="mt-14 space-y-20 md:space-y-24">
      {
        work.map((item, i) => (
          <article
            class:list={[
              'a-reveal grid gap-8 md:gap-16',
              i % 2 === 1 ? 'md:grid-cols-[1.6fr_1fr]' : 'md:grid-cols-[1fr_1.6fr]',
            ]}
          >
            <div class:list={['rounded-sm bg-tint p-6 md:p-10', i % 2 === 1 && 'md:order-2']}>
              <WorkArt art={item.art} class="w-full" />
            </div>
            <div>
              <p class="text-sm font-semibold tracking-[0.14em] text-muted uppercase">
                <span class="text-spark">No. {i + 1}</span> &middot; {item.client} &middot; {item.period}
              </p>
              <h3 class="mt-3 font-display a-display text-3xl leading-tight font-bold md:text-4xl">{item.title}</h3>
              <dl class="mt-6 space-y-3 text-lg leading-relaxed">
                <div>
                  <dt class="mr-1 inline font-semibold">Problem:</dt>
                  <dd class="inline text-muted">{item.problem}</dd>
                </div>
                <div>
                  <dt class="mr-1 inline font-semibold">I did:</dt>
                  <dd class="inline text-muted">{item.did}</dd>
                </div>
                <div>
                  <dt class="mr-1 inline font-semibold">Result:</dt>
                  <dd class="inline text-muted">{item.result}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))
      }
    </div>

    <div class="a-rule mt-20 h-px bg-rule"></div>
    <p class="mt-6 text-lg italic text-muted">{earlierWork}</p>
  </div>
</section>
