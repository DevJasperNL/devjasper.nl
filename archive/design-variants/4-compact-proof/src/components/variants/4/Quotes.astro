---
import { linkedInRecommendations, quotes } from '../../../data/site';
---

<section aria-labelledby="v4-quotes" class="mx-auto max-w-6xl px-5 md:px-12">
  <div class="border-t-2 border-accent pt-12 pb-16 md:pt-14 md:pb-20">
    <h2 id="v4-quotes" class="font-display text-3xl font-black tracking-tight text-accent md:text-5xl">What colleagues say</h2>

    <div class="mt-8 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        quotes.map((q) => (
          <figure class="d-reveal">
            <blockquote class="font-display text-xl leading-snug font-semibold">
              <span class="text-accent" aria-hidden="true">&ldquo;</span>
              {q.text}
              <span class="text-accent" aria-hidden="true">&rdquo;</span>
            </blockquote>
            <figcaption class="mt-3 leading-snug text-muted">
              <span class="font-bold text-ink">{q.name}</span>, {q.role}
              {q.translated && <span> (Translated from Dutch)</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <a
      href={linkedInRecommendations.href}
      class="mt-10 inline-block font-display text-lg font-bold text-accent underline decoration-2 underline-offset-4"
    >
      {linkedInRecommendations.label} <span class="d-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>
