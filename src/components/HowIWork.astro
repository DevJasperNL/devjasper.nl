---
import { howIWork } from '../data/site';
import PointGrid from './PointGrid.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="how-i-work" aria-labelledby="how-i-work-heading" class="bg-tint">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-12 md:py-28">
    <SectionHeading id="how-i-work-heading" rule>How I work</SectionHeading>
    <PointGrid points={howIWork.points} />
    <div class="reveal mt-14 max-w-3xl space-y-5 text-lg leading-relaxed md:text-xl">
      <p class="font-semibold">{howIWork.ai}</p>
      <p class="text-muted">{howIWork.personal}</p>
    </div>
  </div>
</section>
