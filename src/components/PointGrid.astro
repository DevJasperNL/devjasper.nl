---
import type { Point } from '../data/site';

interface Props {
  points: Point[];
}

const { points } = Astro.props;
---

<ul class="mt-12 grid gap-12 md:grid-cols-3 md:gap-10">
  {
    points.map((p) => (
      <li class="reveal">
        <h3 class="font-display text-2xl leading-tight font-extrabold md:text-[1.7rem]">{p.title}</h3>
        <p class="mt-3 text-lg leading-relaxed text-muted">{p.body}</p>
      </li>
    ))
  }
</ul>
