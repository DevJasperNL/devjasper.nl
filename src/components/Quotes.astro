---
import { linkedInRecommendations, quotes } from '../data/site';
import ArrowLink from './ArrowLink.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="quotes" aria-labelledby="quotes-heading" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-12">
    <SectionHeading id="quotes-heading">What colleagues say</SectionHeading>
  </div>

  <!-- Focusable so keyboard users can scroll the swipe row on phones. -->
  <ul
    class="quote-row mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 md:grid md:grid-cols-2 md:gap-8 md:overflow-visible md:pb-0"
    tabindex="0"
    aria-label="Quotes from colleagues"
  >
    {
      quotes.map((q) => (
        <li class="w-[85%] shrink-0 snap-start md:w-auto">
          <figure class="flex h-full flex-col rounded-[1.75rem] bg-accent p-7 text-white md:p-10">
            <span class="font-display text-6xl leading-none font-black" aria-hidden="true">&ldquo;</span>
            <blockquote class="-mt-3 font-display text-xl leading-snug font-semibold md:text-2xl">{q.text}</blockquote>
            <figcaption class="mt-auto pt-8 text-base leading-snug text-white/90">
              <span class="font-bold text-white">{q.name}</span>, {q.role}
              {q.translated && <span> (Translated from Dutch)</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <div class="mx-auto max-w-6xl px-5 md:px-12">
    <ArrowLink href={linkedInRecommendations.href} class="mt-8 text-accent">{linkedInRecommendations.label}</ArrowLink>
  </div>
</section>
