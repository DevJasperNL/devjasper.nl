---
import { services } from '../data/site';
import PointGrid from './PointGrid.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="what-i-do" aria-labelledby="what-i-do-heading" class="mx-auto max-w-6xl px-5 py-20 md:px-12 md:py-28">
  <SectionHeading id="what-i-do-heading" rule>What I do</SectionHeading>
  <PointGrid points={services} />
</section>
