---
import { earlierWork, work } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import WorkArt from './WorkArt.astro';
---

<section id="work" aria-labelledby="work-heading" class="bg-tint">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-12 md:py-28">
    <SectionHeading id="work-heading">Selected work</SectionHeading>

    <!-- Stacking only from md up: on phones the cards are taller than the screen, so the next card would cover unread text. -->
    <div class="mt-12 space-y-8 md:space-y-16">
      {
        work.map((item, i) => (
          <article
            class="rounded-[1.75rem] border-2 border-accent bg-white p-6 md:sticky md:grid md:grid-cols-[1.7fr_1fr] md:gap-10 md:p-10"
            style={`top: ${2 + i * 1.5}rem`}
          >
            <div>
              <p class="font-display text-sm font-bold tracking-wide text-accent uppercase">
                {item.client} &middot; {item.period}
              </p>
              <h3 class="mt-3 font-display text-3xl leading-tight font-black tracking-tight md:text-4xl">{item.title}</h3>
              <dl class="mt-6 space-y-4 text-lg leading-relaxed">
                <div>
                  <dt class="font-display font-bold">Problem</dt>
                  <dd class="text-muted">{item.problem}</dd>
                </div>
                <div>
                  <dt class="font-display font-bold">I did</dt>
                  <dd class="text-muted">{item.did}</dd>
                </div>
                <div>
                  <dt class="font-display font-bold">Result</dt>
                  <dd class="font-semibold">{item.result}</dd>
                </div>
              </dl>
            </div>
            <div class="mt-8 flex items-center rounded-2xl bg-tint p-6 md:mt-0">
              <WorkArt art={item.art} class="w-full" />
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-12 text-lg text-muted">{earlierWork}</p>
  </div>
</section>
