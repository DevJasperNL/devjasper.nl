---
import type { WorkArt } from '../data/site';

/*
  Decorative, so aria-hidden. Strokes and the one highlight use the accent, soft shapes
  the tint. The .art-* classes are hooks for the loops in global.css.
*/
interface Props {
  art: WorkArt;
  class?: string;
}

const { art, class: className } = Astro.props;
---

<svg
  class:list={['work-art', className]}
  viewBox="0 0 240 160"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    art === 'stream' && (
      <g stroke="var(--color-accent)" stroke-width="3">
        <rect x="24" y="52" width="92" height="60" rx="12" fill="var(--color-tint)" class="art-trace" />
        <circle cx="70" cy="82" r="20" fill="var(--color-bg)" class="art-trace" />
        <circle cx="70" cy="82" r="8" fill="var(--color-accent)" stroke="none" class="art-move art-pan" />
        <path d="M58 52 L64 40 H88 L94 52" class="art-trace" />
        <path d="M116 70 L138 60 V104 L116 94" fill="var(--color-tint)" class="art-trace" />
        <path d="M160 64 q12 18 0 36" class="art-move art-wave art-wave-1" />
        <path d="M176 54 q22 28 0 56" class="art-move art-wave art-wave-2" />
        <path d="M192 44 q32 38 0 76" class="art-move art-wave art-wave-3" />
        <path d="M44 132 H196" stroke-dasharray="2 10" />
      </g>
    )
  }
  {
    art === 'identity' && (
      <g stroke="var(--color-accent)" stroke-width="3">
        <path d="M120 80 L44 36 M120 80 L44 80 M120 80 L44 124 M120 80 L196 36 M120 80 L196 80 M120 80 L196 124" class="art-trace" stroke-dasharray="4 6" />
        <rect x="30" y="24" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <rect x="30" y="68" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <rect x="30" y="112" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <rect x="182" y="24" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <rect x="182" y="68" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <rect x="182" y="112" width="28" height="24" rx="6" fill="var(--color-tint)" />
        <g class="art-move art-lock">
          <path d="M106 74 V64 a14 14 0 0 1 28 0 V74" class="art-shackle" />
          <rect x="98" y="74" width="44" height="36" rx="8" fill="var(--color-accent)" />
          <circle cx="120" cy="90" r="4" fill="var(--color-bg)" stroke="none" />
          <path d="M120 94 V100" stroke="var(--color-bg)" />
        </g>
      </g>
    )
  }
  {
    art === 'warehouse' && (
      <g stroke="var(--color-accent)" stroke-width="3">
        <path d="M24 136 H216" />
        <path d="M36 24 V136 M100 24 V136 M140 24 V136 M204 24 V136" class="art-trace" />
        <path d="M36 52 H100 M36 80 H100 M36 108 H100 M140 52 H204 M140 80 H204 M140 108 H204" class="art-trace" />
        <rect x="104" y="30" width="32" height="18" rx="4" fill="var(--color-accent)" class="art-move art-lift" />
        <rect x="44" y="64" width="22" height="14" rx="3" fill="var(--color-tint)" class="art-move art-shuttle" />
        <rect x="170" y="92" width="22" height="14" rx="3" fill="var(--color-tint)" class="art-move art-shuttle art-shuttle-2" />
        <rect x="70" y="36" width="20" height="14" rx="3" fill="var(--color-tint)" />
        <rect x="150" y="36" width="20" height="14" rx="3" fill="var(--color-tint)" />
        <rect x="46" y="120" width="20" height="14" rx="3" fill="var(--color-tint)" />
      </g>
    )
  }
</svg>
