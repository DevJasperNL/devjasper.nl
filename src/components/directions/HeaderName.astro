---
import { hero } from '../../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['font-display leading-tight', className]}>
  <span class="text-lg font-extrabold">{hero.name}</span>
  <span class="hidden font-semibold opacity-80 sm:inline">&nbsp;&middot; {hero.role}</span>
  <span class="block text-sm font-semibold opacity-80 sm:hidden">{hero.role}</span>
</p>
