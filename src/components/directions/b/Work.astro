---
import { earlierWork, work } from '../../../data/site';
import WorkArt from '../WorkArt.astro';

const artBg = ['bg-marker', 'bg-tint', 'bg-marker'];
---

<section aria-labelledby="b-work" class="mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-28">
  <h2 id="b-work" class="font-display b-display text-5xl font-extrabold tracking-tight md:text-7xl">Selected work</h2>

  <div class="mt-12 space-y-10 md:space-y-14">
    {
      work.map((item, i) => (
        <article class="b-reveal">
          <div class="b-card b-shadow grid overflow-hidden rounded-3xl border-2 border-ink bg-white md:grid-cols-[1.6fr_1fr]">
            <div class="p-6 md:p-10">
              <p class="inline-flex flex-wrap gap-2 text-sm font-bold">
                <span class="rounded-full bg-ink px-3 py-1 text-white">{item.client}</span>
                <span class="rounded-full border-2 border-ink px-3 py-0.5">{item.period}</span>
              </p>
              <h3 class="mt-5 font-display b-display text-3xl leading-tight font-extrabold md:text-[2.6rem]">{item.title}</h3>
              <dl class="mt-6 space-y-4 text-lg leading-relaxed">
                <div>
                  <dt class="font-bold text-accent">Problem</dt>
                  <dd>{item.problem}</dd>
                </div>
                <div>
                  <dt class="font-bold text-accent">I did</dt>
                  <dd>{item.did}</dd>
                </div>
                <div>
                  <dt class="font-bold text-accent">Result</dt>
                  <dd class="font-semibold">{item.result}</dd>
                </div>
              </dl>
            </div>
            <div class:list={['flex items-center justify-center border-t-2 border-ink p-8 md:border-t-0 md:border-l-2', artBg[i]]}>
              <WorkArt art={item.art} class="w-full max-w-[18rem]" />
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-12 text-lg text-muted">{earlierWork}</p>
</section>
