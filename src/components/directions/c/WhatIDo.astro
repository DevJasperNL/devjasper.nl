---
import { services } from '../../../data/site';
import SectionLabel from './SectionLabel.astro';
---

<section aria-labelledby="c-what" class="mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-24">
  <SectionLabel index="01" id="c-what" title="What I do" />
  <ol class="mt-12 grid gap-px bg-rule md:grid-cols-3">
    {
      services.map((s, i) => (
        <li class="c-reveal c-row bg-white py-6 md:px-6 md:py-2 md:first:pl-0">
          <span class="font-mono text-sm text-accent" aria-hidden="true">1.{i + 1}</span>
          <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>
