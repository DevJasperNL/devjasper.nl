---
import { services } from '../../../data/site';
---

<section aria-labelledby="d-what" class="mx-auto max-w-6xl px-5 py-20 md:px-12 md:py-28">
  <h2 id="d-what" class="font-display text-4xl font-black tracking-tight text-accent md:text-6xl">What I do</h2>
  <div class="d-grow mt-6 h-1.5 w-full rounded-full bg-accent"></div>
  <ul class="mt-12 grid gap-12 md:grid-cols-3 md:gap-10">
    {
      services.map((s) => (
        <li class="d-reveal">
          <h3 class="font-display text-2xl leading-tight font-extrabold md:text-[1.7rem]">{s.title}</h3>
          <p class="mt-3 text-lg leading-relaxed text-muted">{s.body}</p>
        </li>
      ))
    }
  </ul>
</section>
