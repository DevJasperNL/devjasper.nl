---
import { services } from '../../../data/site';
---

<section aria-labelledby="v4-what" class="mx-auto max-w-6xl px-5 pt-14 pb-12 md:px-12 md:pt-16">
  <h2 id="v4-what" class="font-display text-3xl font-black tracking-tight text-accent md:text-5xl">What I do</h2>
  <ul class="mt-8 grid gap-8 md:grid-cols-3 md:gap-10">
    {
      services.map((s) => (
        <li class="d-reveal">
          <h3 class="font-display text-xl leading-tight font-extrabold md:text-2xl">{s.title}</h3>
          <p class="mt-2 leading-relaxed text-muted md:text-lg">{s.body}</p>
        </li>
      ))
    }
  </ul>
</section>
